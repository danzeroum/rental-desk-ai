# HTTPS automático. DOMAIN=localhost usa certificado interno do Caddy (desenvolvimento).
{
	servers {
		trusted_proxies static private_ranges
	}
	# Logs de erro do proxy também trazem a requisição: mesma limpeza do log de acesso.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete telefone
					delete phone
				}
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
			}
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 20MB
	}

	reverse_proxy app:8000 {
		health_uri /health/live
		health_interval 15s
	}

	# Sem dado pessoal no log de acesso: apaga o telefone de qualquer URL (o painel só manda
	# telefone por POST; isto é a segunda barreira) e encurta o IP (revisão LGPD 24/11/2026).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete telefone
					delete phone
				}
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
			}
		}
	}
}
