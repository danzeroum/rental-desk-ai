# Referência de todas as variáveis de ambiente. Copie para .env ou rode
# `deploy/gen-env.sh` (gera segredos aleatórios). Nunca versione o .env.

# --- Geral -------------------------------------------------------------------
ENV=development                 # development | test | staging | production
DOMAIN=localhost                # domínio do painel; localhost usa certificado interno
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_VERSION=dev                 # tag da imagem (rollback = voltar para a tag anterior)
IMAGE_NAME=rental-desk-ai

# --- Segredos (gerados por deploy/gen-env.sh) --------------------------------
SECRET_KEY=                        # mínimo 32 caracteres aleatórios
POSTGRES_PASSWORD=               # superusuário; usado só pelo backup
DB_OWNER_PASSWORD=               # rentaldesk_owner: migrações
DB_APP_PASSWORD=                 # rentaldesk_app: caminho de requisição, sem BYPASSRLS
DB_OPS_PASSWORD=                 # rentaldesk_ops: tarefas globais do operador
REDIS_PASSWORD=

DATA_ENCRYPTION_KEYS=             # k1:<32 bytes em base64>; rotação: k2:<nova>,k1:<antiga>

# --- WhatsApp (Cloud API, direta ou via parceiro oficial) ---------------------
WHATSAPP_PROVIDER=fake            # cloud_api | fake (fake é recusado em produção)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0   # ou a URL do parceiro (BSP)
WHATSAPP_AUTH_HEADER=Authorization  # ex.: D360-API-KEY em parceiros
WHATSAPP_AUTH_SCHEME=Bearer       # vazio quando o parceiro usa só a chave
WHATSAPP_APP_SECRET=              # confere X-Hub-Signature-256 (obrigatório em produção)
WHATSAPP_VERIFY_TOKEN=            # desafio do webhook (obrigatório em produção)

# --- Transcrição de áudio (contratar sem uso para treino) ---------------------
TRANSCRIBER_PROVIDER=fake         # openai_compatible | fake (fake é recusado em produção)
TRANSCRIBER_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBER_API_KEY=
TRANSCRIBER_MODEL=whisper-1

# --- LLM (extração e frases curtas; contratar sem uso dos dados para treino) ---
LLM_PROVIDER=fake                 # anthropic | fake (fake é recusado em produção)
LLM_MODEL=claude-haiku-5-5        # o mais barato aprovado no make golden-live
LLM_API_KEY=
LLM_EFFORT=low                    # low | medium | high | xhigh | max
# LLM_TIMEOUT_SECONDS=20  LLM_REFUSAL_FALLBACK=true

# --- Fila e atendimento (padrões do SPEC) ---------------------------------------
# DEBOUNCE_QUIET_SECONDS=6  DEBOUNCE_MAX_SECONDS=20
# RATE_LIMIT_PER_MINUTE=15  RATE_LIMIT_SILENCE_SECONDS=600

# --- Backup --------------------------------------------------------------------
BACKUP_PASSPHRASE=               # cifra os dumps (gpg AES-256); guarde fora da VPS
BACKUP_HOUR=03                    # hora local (America/Sao_Paulo)
BACKUP_RETENTION_DAYS=30

# --- Montadas pelo docker-compose a partir das senhas acima --------------------
# DATABASE_URL=postgresql://rentaldesk_app:<DB_APP_PASSWORD>@postgres:5432/rentaldesk
# DATABASE_MIGRATION_URL=postgresql://rentaldesk_owner:<DB_OWNER_PASSWORD>@postgres:5432/rentaldesk
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# PUBLIC_BASE_URL=https://<DOMAIN>
# DB_POOL_SIZE=10
# HEALTH_TIMEOUT_SECONDS=2
