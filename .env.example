# Referência de todas as variáveis de ambiente. Copie para .env ou rode
# `deploy/gen-env.sh` (gera segredos aleatórios). Nunca versione o .env.

# --- Geral -------------------------------------------------------------------
ENV=development                 # development | test | staging | production
DOMAIN=localhost                # domínio do painel; localhost usa certificado interno
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_VERSION=dev                 # tag da imagem (rollback = voltar para a tag anterior)
IMAGE_NAME=rental-desk-ai

# --- Segredos (gerados por deploy/gen-env.sh) --------------------------------
SECRET_KEY=                        # mínimo 32 caracteres aleatórios
POSTGRES_PASSWORD=               # superusuário; usado só pelo backup
DB_OWNER_PASSWORD=               # rentaldesk_owner: migrações
DB_APP_PASSWORD=                 # rentaldesk_app: caminho de requisição, sem BYPASSRLS
DB_OPS_PASSWORD=                 # rentaldesk_ops: tarefas globais do operador
REDIS_PASSWORD=

# --- Backup --------------------------------------------------------------------
BACKUP_PASSPHRASE=               # cifra os dumps (gpg AES-256); guarde fora da VPS
BACKUP_HOUR=03                    # hora local (America/Sao_Paulo)
BACKUP_RETENTION_DAYS=30

# --- Montadas pelo docker-compose a partir das senhas acima --------------------
# DATABASE_URL=postgresql://rentaldesk_app:<DB_APP_PASSWORD>@postgres:5432/rentaldesk
# DATABASE_MIGRATION_URL=postgresql://rentaldesk_owner:<DB_OWNER_PASSWORD>@postgres:5432/rentaldesk
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# PUBLIC_BASE_URL=https://<DOMAIN>
# DB_POOL_SIZE=10
# HEALTH_TIMEOUT_SECONDS=2
